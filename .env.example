# Copy this file to .env, then recreate the service after changing values.
# full: six qualities (1080p to 240p); light: one 720p quality.
STREAM_PROFILE=full

# OBS on this machine: 127.0.0.1
# OBS on another machine: the Docker host's LAN IP, or 0.0.0.0 for all IPv4 interfaces.
RTMP_BIND_ADDRESS=127.0.0.1

# Optional HTTPS mode: uncomment after installing the certificate and key.
# COMPOSE_PROFILES=https
# STREAM_DOMAIN=stream.example.com

# Change these if another service already uses host ports 80 or 443.
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
