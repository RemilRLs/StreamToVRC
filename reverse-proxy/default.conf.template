server {
    listen 80;
    server_name ${STREAM_DOMAIN};
    server_tokens off;

    return 301 https://${STREAM_DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    server_name ${STREAM_DOMAIN};
    server_tokens off;

    ssl_certificate /etc/nginx/certificates/stream.crt;
    ssl_certificate_key /etc/nginx/certificates/stream.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    location /hls/ {
        # Resolve the Compose service again if its container IP changes.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $hls_backend rtmp-hls:80;
        proxy_pass http://$hls_backend$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_buffering off;
        proxy_cache off;

        # Keep the upstream HLS MIME, cache and CORS headers without duplicating them.
    }

    # Do not publish RTMP statistics or other upstream routes over this proxy.
    location / {
        return 404;
    }
}
